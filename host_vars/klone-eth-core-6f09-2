bridge:
  # interfaces:
  #    - { name: "glob bond1-24"}
  #    - { name: "glob bond31-54" }
  #    - { name: "peerlink"}
  vids:
    - 20
    - 116
    - 200
    - 201
    - 3900
    - 3901
    - 3902
    - 3903
    - 3904
    - 3906
  extras:
    - "bridge-pvid 3900"

vlans:
  - "{{ leaf_vlan20 }}"
  - "{{ leaf_vlan116 }}"
  - "{{ leaf_vlan200 }}"
  - "{{ leaf_vlan201 }}"
  - "{{ leaf_vlan3900 }}"
  - "{{ leaf_vlan3901 }}"
  - "{{ leaf_vlan3902 }}"
  - "{{ leaf_vlan3903 }}"
  - "{{ leaf_vlan3904 }}"
  - "{{ leaf_vlan3906 }}"

peerlink:
  extras:
    - "mtu 9216"

mlag:
  sysmac: "{{mlag_sysmac_prefix}}:AA"
  priority: secondary
  peerlinks: [ swp26, swp30 ]
  backup: "{{vxlan_local_loopback_subnet}}.102"
  bonds:
    # Left Side to Leafs
    - { profile: "{{ mlagBondProfile_switch }}", name: bond1, ports: [swp1], id: 1 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond2, ports: [swp2], id: 2 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond3, ports: [swp3], id: 3 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond4, ports: [swp4], id: 4 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond5, ports: [swp5], id: 5 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond6, ports: [swp6], id: 6 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond7, ports: [swp7], id: 7 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond8, ports: [swp8], id: 8 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond9, ports: [swp9], id: 9 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond10, ports: [swp10], id: 10 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond11, ports: [swp11], id: 11 }
    - { profile: "{{ mlagBondProfile_switch }}", name: bond12, ports: [swp12], id: 12 }
