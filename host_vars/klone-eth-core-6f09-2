  - { name: "swp15", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp16", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp17", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp18", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp19", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp20", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp21", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp22", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp23", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp24", profile: "{{ leaf_spine_interface }}" }

  # Middle '100g' ports

  # Uplink to Science DMZ
  #- { name: "swp25", profile: "{{ uplink_ports_mlag }}" } # QSFP28 100gbit (old UW uplink 40G)
  - { name: "swp25", profile: "{{ oldcore_leaf_ports_mlag }}" } # QSFP28 100gbit (new uplink to "new core" 100G)

  # Downlink to Kopah switch
  - { name: "swp29", profile: "{{ ceph_leaf_ports_mlag }}" } # QSFP28 100gbit

  # Connected to other core
  - { name: "swp26", profile: "{{ spine_spine_interface }}" } # QSFP28 100gbit
  - { name: "swp30", profile: "{{ spine_spine_interface }}" } # QSFP28 100gbit

  # Right side (connect to servers)
  - { name: "swp31", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp32", profile: "{{ leaf_spine_interface }}" }
  - { name: "swp33", profile: "{{ ceph_oob_ports_mlag }}" }
  - { name: "swp34", profile: "{{ server_ports_mlag }}" }
  - { name: "swp35", profile: "{{ server_ports_mlag }}" }
  - { name: "swp36", profile: "{{ server_ports_mlag }}" }
