    # Downlinks to Ceph switches
    - { profile: "{{ mlagBondProfile_orci }}", name: bond29, ports: [swp29], id: 29 }
    # Right side to servers, etc
    - { profile: "{{ mlagBondProfile_switch }}", name: bond31, ports: [swp31], id: 31 }
