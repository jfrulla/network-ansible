  - { name: swp51, profile: "{{ leaf_spine_interface }}" }
  - { name: swp52, profile: "{{ leaf_spine_interface }}" }
  # Uplink bond to cores
  - { name: bond0, profile: "{{ leaf_uplink_bond_interface }}" }

bridge:
  interfaces:
    - { name: "glob swp1-48" }
    - { name: "bond0"}
  vids:
    - 20
    - 200
    - 201
    - 3900
    - 3904
    - 3906
  extras:
    - "bridge-pvid 3900"

vlans:
  - "{{ leaf_vlan20 }}"
  - "{{ leaf_vlan200 }}"
  - "{{ leaf_vlan201 }}"
  - "{{ leaf_vlan3900 }}"
  - "{{ leaf_vlan3904 }}"
  - "{{ leaf_vlan3906 }}" 

